# Telegram Bot & Mini App Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=your_bot_username

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Provider Configuration (gemini, openai, etc.)
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key

# Application Base URL
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Security & Session
JWT_SECRET=super_secret_jwt_key_must_be_at_least_32_chars

# Development Fallback: Set to true for browser testing outside Telegram WebApp
NEXT_PUBLIC_DEV_MODE=true
